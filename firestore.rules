rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function auditPath(auditId) {
      return /databases/$(database)/documents/verificationAudit/$(auditId);
    }

    function validAdminDecision(warungId, data) {
      return isAdmin()
        && data.verificationStatus in ['verified', 'rejected']
        && data.verificationAuditId is string
        && data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verificationStatus', 'verificationAuditId', 'updatedAt'
        ])
        && resource.data.verificationStatus == 'pending'
        && getAfter(auditPath(data.verificationAuditId)).data.warungId == warungId
        && getAfter(auditPath(data.verificationAuditId)).data.previousStatus == 'pending'
        && getAfter(auditPath(data.verificationAuditId)).data.newStatus == data.verificationStatus
        && getAfter(auditPath(data.verificationAuditId)).data.warungName == resource.data.name
        && getAfter(auditPath(data.verificationAuditId)).data.actorUid == request.auth.uid
        && getAfter(auditPath(data.verificationAuditId)).data.createdAt == request.time;
    }


    function reportModerationPath(reportId) {
      return /databases/$(database)/documents/postReportModeration/$(reportId);
    }

    function reportAuditPath(auditId) {
      return /databases/$(database)/documents/postReportAudit/$(auditId);
    }

    function validReportModeration(reportId, data, previousStatus) {
      return isAdmin()
        && exists(/databases/$(database)/documents/postReports/$(reportId))
        && data.keys().hasAll(['reportId', 'status', 'updatedBy', 'updatedAt', 'latestAuditId'])
        && data.keys().hasOnly(['reportId', 'status', 'updatedBy', 'updatedAt', 'latestAuditId'])
        && data.reportId == reportId
        && data.status in ['Ditinjau', 'Selesai']
        && data.status != previousStatus
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.latestAuditId is string
        && getAfter(reportAuditPath(data.latestAuditId)).data.reportId == reportId
        && getAfter(reportAuditPath(data.latestAuditId)).data.previousStatus == previousStatus
        && getAfter(reportAuditPath(data.latestAuditId)).data.newStatus == data.status
        && getAfter(reportAuditPath(data.latestAuditId)).data.actorUid == request.auth.uid
        && getAfter(reportAuditPath(data.latestAuditId)).data.createdAt == request.time;
    }

    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.email is string;
    }

    function reactionField(emoji) {
      let fields = {
        '👍': 'like',
        '❤️': 'love',
        '😂': 'haha',
        '😮': 'wow',
        '😢': 'sad',
        '😡': 'angry',
        '👎': 'thumbs_down',
        '🔥': 'fire',
        '🎉': 'party',
        '🤩': 'star_eyes',
        '😱': 'scream',
        '💩': 'poop',
        '🤮': 'vomit',
        '💔': 'broken_heart',
        '🥰': 'smiling_hearts',
        '😍': 'heart_eyes',
        '😎': 'sunglasses',
        '🤓': 'nerd',
        '🤔': 'thinking',
        '🫡': 'salute',
        '🤝': 'handshake',
        '👏': 'clap',
        '🙏': 'pray',
        '💯': 'hundred',
        '⚡': 'lightning',
        '🕊️': 'dove',
        '🎃': 'jack_o_lantern',
        '💅': 'nail_polish',
        '🤡': 'clown',
        '🗿': 'moai',
        '🆒': 'cool_button',
        '😐': 'neutral',
        '😴': 'sleep',
        '🤨': 'raised_eyebrow',
        '🤷‍♂️': 'shrug_man',
        '🤷‍♀️': 'shrug_woman'
      };
      return fields.get(emoji, '');
    }

    function expectedReactionCount(oldReactions, newReactions, oldEmoji, newEmoji, emoji) {
      let field = reactionField(emoji);
      return newReactions.get(field, -1) == oldReactions.get(field, 0)
        + (newEmoji == emoji ? 1 : 0)
        - (oldEmoji == emoji ? 1 : 0);
    }

    function validReactionAggregateUpdate(postId) {
      let reactionPath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      let beforeExists = exists(reactionPath);
      let afterExists = existsAfter(reactionPath);
      let beforeEmoji = beforeExists ? get(reactionPath).data.get('emoji', '👍') : '';
      let afterEmoji = afterExists ? getAfter(reactionPath).data.get('emoji', '') : '';
      let oldReactions = resource.data.get('reactions', {});
      let newReactions = request.resource.data.get('reactions', {});
      return signedIn()
        && resource.data.keys().hasAll(['reactions', 'totalReactions'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'totalReactions'])
        && oldReactions is map && newReactions is map
        && oldReactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && oldReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry', 'thumbs_down', 'fire', 'party', 'star_eyes', 'scream', 'poop', 'vomit', 'broken_heart', 'smiling_hearts', 'heart_eyes', 'sunglasses', 'nerd', 'thinking', 'salute', 'handshake', 'clap', 'pray', 'hundred', 'lightning', 'dove', 'jack_o_lantern', 'nail_polish', 'clown', 'moai', 'cool_button', 'neutral', 'sleep', 'raised_eyebrow', 'shrug_man', 'shrug_woman'])
        && resource.data.totalReactions is number && request.resource.data.totalReactions is number
        && request.resource.data.totalReactions >= 0
        && (
          // Expanded schema: Android can use the full Telegram-style set.
          (newReactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry', 'thumbs_down', 'fire', 'party', 'star_eyes', 'scream', 'poop', 'vomit', 'broken_heart', 'smiling_hearts', 'heart_eyes', 'sunglasses', 'nerd', 'thinking', 'salute', 'handshake', 'clap', 'pray', 'hundred', 'lightning', 'dove', 'jack_o_lantern', 'nail_polish', 'clown', 'moai', 'cool_button', 'neutral', 'sleep', 'raised_eyebrow', 'shrug_man', 'shrug_woman'])
            && newReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry', 'thumbs_down', 'fire', 'party', 'star_eyes', 'scream', 'poop', 'vomit', 'broken_heart', 'smiling_hearts', 'heart_eyes', 'sunglasses', 'nerd', 'thinking', 'salute', 'handshake', 'clap', 'pray', 'hundred', 'lightning', 'dove', 'jack_o_lantern', 'nail_polish', 'clown', 'moai', 'cool_button', 'neutral', 'sleep', 'raised_eyebrow', 'shrug_man', 'shrug_woman'])
          && newReactions.like is number && newReactions.like >= 0
          && newReactions.love is number && newReactions.love >= 0
          && newReactions.haha is number && newReactions.haha >= 0
          && newReactions.wow is number && newReactions.wow >= 0
          && newReactions.sad is number && newReactions.sad >= 0
          && newReactions.angry is number && newReactions.angry >= 0
          && newReactions.thumbs_down is number && newReactions.thumbs_down >= 0
          && newReactions.fire is number && newReactions.fire >= 0
          && newReactions.party is number && newReactions.party >= 0
          && newReactions.star_eyes is number && newReactions.star_eyes >= 0
          && newReactions.scream is number && newReactions.scream >= 0
          && newReactions.poop is number && newReactions.poop >= 0
          && newReactions.vomit is number && newReactions.vomit >= 0
          && newReactions.broken_heart is number && newReactions.broken_heart >= 0
          && newReactions.smiling_hearts is number && newReactions.smiling_hearts >= 0
          && newReactions.heart_eyes is number && newReactions.heart_eyes >= 0
          && newReactions.sunglasses is number && newReactions.sunglasses >= 0
          && newReactions.nerd is number && newReactions.nerd >= 0
          && newReactions.thinking is number && newReactions.thinking >= 0
          && newReactions.salute is number && newReactions.salute >= 0
          && newReactions.handshake is number && newReactions.handshake >= 0
          && newReactions.clap is number && newReactions.clap >= 0
          && newReactions.pray is number && newReactions.pray >= 0
          && newReactions.hundred is number && newReactions.hundred >= 0
          && newReactions.lightning is number && newReactions.lightning >= 0
          && newReactions.dove is number && newReactions.dove >= 0
          && newReactions.jack_o_lantern is number && newReactions.jack_o_lantern >= 0
          && newReactions.nail_polish is number && newReactions.nail_polish >= 0
          && newReactions.clown is number && newReactions.clown >= 0
          && newReactions.moai is number && newReactions.moai >= 0
          && newReactions.cool_button is number && newReactions.cool_button >= 0
          && newReactions.neutral is number && newReactions.neutral >= 0
          && newReactions.sleep is number && newReactions.sleep >= 0
          && newReactions.raised_eyebrow is number && newReactions.raised_eyebrow >= 0
          && newReactions.shrug_man is number && newReactions.shrug_man >= 0
          && newReactions.shrug_woman is number && newReactions.shrug_woman >= 0
            && request.resource.data.totalReactions == newReactions.like + newReactions.love + newReactions.haha + newReactions.wow + newReactions.sad + newReactions.angry + newReactions.thumbs_down + newReactions.fire + newReactions.party + newReactions.star_eyes + newReactions.scream + newReactions.poop + newReactions.vomit + newReactions.broken_heart + newReactions.smiling_hearts + newReactions.heart_eyes + newReactions.sunglasses + newReactions.nerd + newReactions.thinking + newReactions.salute + newReactions.handshake + newReactions.clap + newReactions.pray + newReactions.hundred + newReactions.lightning + newReactions.dove + newReactions.jack_o_lantern + newReactions.nail_polish + newReactions.clown + newReactions.moai + newReactions.cool_button + newReactions.neutral + newReactions.sleep + newReactions.raised_eyebrow + newReactions.shrug_man + newReactions.shrug_woman
            && (
              (beforeExists && !afterExists && beforeEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️'])
              || (!beforeExists && afterExists && afterEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️'])
              || (beforeExists && afterExists && beforeEmoji != afterEmoji
                && afterEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️']
                && (beforeEmoji == '' || beforeEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️']))
            )
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '👍')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '❤️')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😂')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😮')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😢')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😡')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '👎')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🔥')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🎉')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤩')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😱')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '💩')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤮')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '💔')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🥰')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😍')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😎')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤓')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤔')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🫡')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤝')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '👏')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🙏')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '💯')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '⚡')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🕊️')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🎃')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '💅')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤡')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🗿')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🆒')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😐')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😴')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤨')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤷‍♂️')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '🤷‍♀️')
          )
          ||
          // Backward compatibility for existing web clients/posts using six reactions.
          (oldReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
            && newReactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
            && newReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
          && newReactions.like is number && newReactions.like >= 0
          && newReactions.love is number && newReactions.love >= 0
          && newReactions.haha is number && newReactions.haha >= 0
          && newReactions.wow is number && newReactions.wow >= 0
          && newReactions.sad is number && newReactions.sad >= 0
          && newReactions.angry is number && newReactions.angry >= 0
            && request.resource.data.totalReactions == newReactions.like + newReactions.love + newReactions.haha + newReactions.wow + newReactions.sad + newReactions.angry
            && beforeEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡']
            && afterEmoji in ['👍', '❤️', '😂', '😮', '😢', '😡']
            && (
              (beforeExists && !afterExists)
              || (!beforeExists && afterExists)
              || (beforeExists && afterExists && beforeEmoji != afterEmoji)
            )
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '👍')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '❤️')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😂')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😮')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😢')
          && expectedReactionCount(oldReactions, newReactions, beforeEmoji, afterEmoji, '😡')
          )
        )
        && request.resource.data.totalReactions == resource.data.totalReactions
          + (beforeExists ? (afterExists ? 0 : -1) : 1);
    }

    function validPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'body', 'topic', 'createdAt', 'reactions', 'totalReactions'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'body', 'topic', 'createdAt', 'reactions', 'totalReactions'])
        && data.reactions is map
        && (
          // Existing web posts still use the original six-key schema.
          (data.reactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
            && data.reactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
          && data.reactions.like is number && data.reactions.like >= 0
          && data.reactions.love is number && data.reactions.love >= 0
          && data.reactions.haha is number && data.reactions.haha >= 0
          && data.reactions.wow is number && data.reactions.wow >= 0
          && data.reactions.sad is number && data.reactions.sad >= 0
          && data.reactions.angry is number && data.reactions.angry >= 0
            && data.totalReactions is number && data.totalReactions >= 0
            && data.totalReactions == data.reactions.like + data.reactions.love + data.reactions.haha + data.reactions.wow + data.reactions.sad + data.reactions.angry)
          ||
          // New Android posts use the expanded Telegram-style reaction schema.
          (data.reactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry', 'thumbs_down', 'fire', 'party', 'star_eyes', 'scream', 'poop', 'vomit', 'broken_heart', 'smiling_hearts', 'heart_eyes', 'sunglasses', 'nerd', 'thinking', 'salute', 'handshake', 'clap', 'pray', 'hundred', 'lightning', 'dove', 'jack_o_lantern', 'nail_polish', 'clown', 'moai', 'cool_button', 'neutral', 'sleep', 'raised_eyebrow', 'shrug_man', 'shrug_woman'])
            && data.reactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry', 'thumbs_down', 'fire', 'party', 'star_eyes', 'scream', 'poop', 'vomit', 'broken_heart', 'smiling_hearts', 'heart_eyes', 'sunglasses', 'nerd', 'thinking', 'salute', 'handshake', 'clap', 'pray', 'hundred', 'lightning', 'dove', 'jack_o_lantern', 'nail_polish', 'clown', 'moai', 'cool_button', 'neutral', 'sleep', 'raised_eyebrow', 'shrug_man', 'shrug_woman'])
          && data.reactions.like is number && data.reactions.like >= 0
          && data.reactions.love is number && data.reactions.love >= 0
          && data.reactions.haha is number && data.reactions.haha >= 0
          && data.reactions.wow is number && data.reactions.wow >= 0
          && data.reactions.sad is number && data.reactions.sad >= 0
          && data.reactions.angry is number && data.reactions.angry >= 0
          && data.reactions.thumbs_down is number && data.reactions.thumbs_down >= 0
          && data.reactions.fire is number && data.reactions.fire >= 0
          && data.reactions.party is number && data.reactions.party >= 0
          && data.reactions.star_eyes is number && data.reactions.star_eyes >= 0
          && data.reactions.scream is number && data.reactions.scream >= 0
          && data.reactions.poop is number && data.reactions.poop >= 0
          && data.reactions.vomit is number && data.reactions.vomit >= 0
          && data.reactions.broken_heart is number && data.reactions.broken_heart >= 0
          && data.reactions.smiling_hearts is number && data.reactions.smiling_hearts >= 0
          && data.reactions.heart_eyes is number && data.reactions.heart_eyes >= 0
          && data.reactions.sunglasses is number && data.reactions.sunglasses >= 0
          && data.reactions.nerd is number && data.reactions.nerd >= 0
          && data.reactions.thinking is number && data.reactions.thinking >= 0
          && data.reactions.salute is number && data.reactions.salute >= 0
          && data.reactions.handshake is number && data.reactions.handshake >= 0
          && data.reactions.clap is number && data.reactions.clap >= 0
          && data.reactions.pray is number && data.reactions.pray >= 0
          && data.reactions.hundred is number && data.reactions.hundred >= 0
          && data.reactions.lightning is number && data.reactions.lightning >= 0
          && data.reactions.dove is number && data.reactions.dove >= 0
          && data.reactions.jack_o_lantern is number && data.reactions.jack_o_lantern >= 0
          && data.reactions.nail_polish is number && data.reactions.nail_polish >= 0
          && data.reactions.clown is number && data.reactions.clown >= 0
          && data.reactions.moai is number && data.reactions.moai >= 0
          && data.reactions.cool_button is number && data.reactions.cool_button >= 0
          && data.reactions.neutral is number && data.reactions.neutral >= 0
          && data.reactions.sleep is number && data.reactions.sleep >= 0
          && data.reactions.raised_eyebrow is number && data.reactions.raised_eyebrow >= 0
          && data.reactions.shrug_man is number && data.reactions.shrug_man >= 0
          && data.reactions.shrug_woman is number && data.reactions.shrug_woman >= 0
            && data.totalReactions is number && data.totalReactions >= 0
            && data.totalReactions == data.reactions.like + data.reactions.love + data.reactions.haha + data.reactions.wow + data.reactions.sad + data.reactions.angry + data.reactions.thumbs_down + data.reactions.fire + data.reactions.party + data.reactions.star_eyes + data.reactions.scream + data.reactions.poop + data.reactions.vomit + data.reactions.broken_heart + data.reactions.smiling_hearts + data.reactions.heart_eyes + data.reactions.sunglasses + data.reactions.nerd + data.reactions.thinking + data.reactions.salute + data.reactions.handshake + data.reactions.clap + data.reactions.pray + data.reactions.hundred + data.reactions.lightning + data.reactions.dove + data.reactions.jack_o_lantern + data.reactions.nail_polish + data.reactions.clown + data.reactions.moai + data.reactions.cool_button + data.reactions.neutral + data.reactions.sleep + data.reactions.raised_eyebrow + data.reactions.shrug_man + data.reactions.shrug_woman)
        )
        && data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && (!data.keys().hasAny(['authorPhotoURL']) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048))
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 2000
        && data.topic in ['Obrolan Umum', 'Tanya Jawab', 'Info Layanan', 'Ide & Saran']
        && data.createdAt == request.time;
    }

    function validWarung(data) {
      return data.keys().hasAll([
          'name', 'nameNormalized', 'ownerUid', 'coordinates', 'address',
          'regionCode', 'facilities', 'priceRange', 'openingHours', 'photos',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'nameNormalized', 'ownerUid', 'coordinates', 'address',
          'regionCode', 'facilities', 'priceRange', 'openingHours', 'photos',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.nameNormalized is string && data.nameNormalized.size() >= 2 && data.nameNormalized.size() <= 120
        && data.ownerUid is string
        && data.coordinates is map
        && data.coordinates.keys().hasAll(['lat', 'lng'])
        && data.coordinates.keys().hasOnly(['lat', 'lng'])
        && data.coordinates.lat is number && data.coordinates.lat >= -90 && data.coordinates.lat <= 90
        && data.coordinates.lng is number && data.coordinates.lng >= -180 && data.coordinates.lng <= 180
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.regionCode == 'lamongan-kab'
        && data.facilities is list && data.facilities.size() <= 20
        && data.priceRange in ['hemat', 'sedang', 'premium', 'belum-diisi']
        && data.openingHours is map
        && data.photos is list && data.photos.size() <= 5
        && data.verificationStatus == 'pending'
        && !data.keys().hasAny(['verificationAuditId'])
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validWarungEdit(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.nameNormalized is string && data.nameNormalized.size() >= 2 && data.nameNormalized.size() <= 120
        && data.coordinates is map
        && data.coordinates.keys().hasAll(['lat', 'lng'])
        && data.coordinates.keys().hasOnly(['lat', 'lng'])
        && data.coordinates.lat is number && data.coordinates.lat >= -90 && data.coordinates.lat <= 90
        && data.coordinates.lng is number && data.coordinates.lng >= -180 && data.coordinates.lng <= 180
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.regionCode == 'lamongan-kab'
        && data.facilities is list && data.facilities.size() <= 20
        && data.priceRange in ['hemat', 'sedang', 'premium', 'belum-diisi']
        && data.openingHours is map
        && data.photos is list && data.photos.size() <= 5
        && data.updatedAt == request.time;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfile(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && (!request.resource.data.keys().hasAny(['photoURL']) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && validPost(request.resource.data);
      allow update: if (
        signedIn()
        && resource.data.authorId == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'topic'])
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 2000
            && request.resource.data.topic in ['Obrolan Umum', 'Tanya Jawab', 'Info Layanan', 'Ide & Saran']
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
            && request.resource.data.deleting == true
          )
        )
      ) || validReactionAggregateUpdate(postId);
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.get('deleting', false) == true;
    }

    match /posts/{postId}/likes/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'emoji'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time
        && (!('emoji' in request.resource.data) || request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️'])
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) != true;
      allow delete: if signedIn()
        && (
          request.auth.uid == userId
          || (
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
            && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) == true
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
        && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '😡', '👎', '🔥', '🎉', '🤩', '😱', '💩', '🤮', '💔', '🥰', '😍', '😎', '🤓', '🤔', '🫡', '🤝', '👏', '🙏', '💯', '⚡', '🕊️', '🎃', '💅', '🤡', '🗿', '🆒', '😐', '😴', '🤨', '🤷‍♂️', '🤷‍♀️'];
    }

    match /posts/{postId}/replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) != true
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'body', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'body', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && (!request.resource.data.keys().hasAny(['authorPhotoURL']) || request.resource.data.authorPhotoURL == null || (request.resource.data.authorPhotoURL is string && request.resource.data.authorPhotoURL.size() <= 2048))
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) == true;
    }

    // Direktori publik hanya menampilkan warkop yang telah diverifikasi.
    // Pemilik tetap dapat membaca dokumen miliknya saat masih menunggu verifikasi.
    match /warungs/{warungId} {
      allow read: if isAdmin()
        || resource.data.verificationStatus == 'verified'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validWarung(request.resource.data);
      // Status verifikasi, pemilik, dan waktu pembuatan tidak dapat diubah oleh pemilik.
      allow update: if validAdminDecision(warungId, request.resource.data)
        || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nameNormalized', 'coordinates', 'address', 'regionCode',
          'facilities', 'priceRange', 'openingHours', 'photos', 'updatedAt'
        ])
        && validWarungEdit(request.resource.data));
      allow delete: if false;
    }

    // Catatan audit hanya dapat dibuat sebagai bagian dari keputusan admin atomik.
    match /verificationAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'warungId', 'warungName', 'previousStatus', 'newStatus',
          'actorUid', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'warungId', 'warungName', 'previousStatus', 'newStatus',
          'actorUid', 'reason', 'createdAt'
        ])
        && request.resource.data.warungId is string
        && request.resource.data.warungName is string
        && request.resource.data.previousStatus == 'pending'
        && request.resource.data.newStatus in ['verified', 'rejected']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && (request.resource.data.newStatus != 'rejected' || request.resource.data.reason.size() > 0)
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationStatus == 'pending'
        && getAfter(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationStatus == request.resource.data.newStatus
        && getAfter(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationAuditId == auditId;
      allow update, delete: if false;
    }
    // Laporan bersifat privat dan hanya admin yang boleh membacanya.
    // ID deterministik membatasi satu laporan per akun untuk setiap postingan.
    match /postReports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['targetPostId', 'targetAuthorId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['targetPostId', 'targetAuthorId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.targetPostId is string
        && reportId == request.resource.data.targetPostId + '_' + request.auth.uid
        && request.resource.data.targetAuthorId is string
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['Spam atau promosi berulang', 'Pelecehan atau ujaran kebencian', 'Informasi berbahaya atau menyesatkan', 'Lainnya']
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId)).data.authorId == request.resource.data.targetAuthorId;
      allow update, delete: if false;
    }


    // Status moderasi terpisah dari laporan asli. Hanya admin dapat membaca/menulis.
    // Setiap perubahan wajib disertai peristiwa audit dalam batch yang sama.
    match /postReportModeration/{reportId} {
      allow read: if isAdmin();
      allow create: if !exists(reportModerationPath(reportId))
        && validReportModeration(reportId, request.resource.data, 'Baru');
      allow update: if resource.data.reportId == reportId
        && validReportModeration(reportId, request.resource.data, resource.data.status);
      allow delete: if false;
    }

    // Audit moderasi bersifat append-only dan tidak dapat diperbarui/dihapus.
    match /postReportAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'reportId', 'previousStatus', 'newStatus', 'actorUid', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reportId', 'previousStatus', 'newStatus', 'actorUid', 'note', 'createdAt'
        ])
        && request.resource.data.reportId is string
        && exists(/databases/$(database)/documents/postReports/$(request.resource.data.reportId))
        && request.resource.data.previousStatus in ['Baru', 'Ditinjau', 'Selesai']
        && request.resource.data.newStatus in ['Ditinjau', 'Selesai']
        && request.resource.data.newStatus != request.resource.data.previousStatus
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && ((!exists(reportModerationPath(request.resource.data.reportId))
          && request.resource.data.previousStatus == 'Baru')
          || (exists(reportModerationPath(request.resource.data.reportId))
          && get(reportModerationPath(request.resource.data.reportId)).data.status == request.resource.data.previousStatus))
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.status == request.resource.data.newStatus
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.reportId == request.resource.data.reportId
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.updatedBy == request.auth.uid
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.updatedAt == request.time
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.latestAuditId == auditId;
      allow update, delete: if false;
    }

  }
}
