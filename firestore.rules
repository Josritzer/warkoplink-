rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userFollowPath(followerUid, followedUid) {
      return /databases/$(database)/documents/userFollows/$(followerUid + '_' + followedUid);
    }

    function mutuallyFollows(uidA, uidB) {
      return uidA is string && uidB is string && uidA != uidB
        && exists(userFollowPath(uidA, uidB))
        && exists(userFollowPath(uidB, uidA));
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function validLatestConversationMessage(conversationId, data) {
      return data.lastMessageId is string
        && existsAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(data.lastMessageId))
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(data.lastMessageId)).data.senderUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(data.lastMessageId)).data.recipientUid == data.unreadFor;
    }

    // Only the fixed platform owner account may use privileged platform controls.
    // Legacy admin claims remain accepted for this exact UID during migration.
    function isPlatformOwner() {
      return signedIn()
        && request.auth.uid == 'OYgUG5eMWjfmHJ0VLaSXr34H7Dv2'
        && (
          request.auth.token.platformRole == 'super_admin'
          || request.auth.token.admin == true
        );
    }

    function isSuperAdmin() {
      return isPlatformOwner();
    }

    // Kept as a compatibility helper for existing report rules; it grants no
    // separate moderator tier and resolves only to the platform owner.
    function isModerator() {
      return isPlatformOwner();
    }

    function auditPath(auditId) {
      return /databases/$(database)/documents/verificationAudit/$(auditId);
    }

    function validAdminDecision(warungId, data) {
      return isSuperAdmin()
        && data.verificationStatus in ['verified', 'rejected']
        && data.verificationAuditId is string
        && data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verificationStatus', 'verificationAuditId', 'updatedAt'
        ])
        && resource.data.verificationStatus == 'pending'
        && getAfter(auditPath(data.verificationAuditId)).data.warungId == warungId
        && getAfter(auditPath(data.verificationAuditId)).data.previousStatus == 'pending'
        && getAfter(auditPath(data.verificationAuditId)).data.newStatus == data.verificationStatus
        && getAfter(auditPath(data.verificationAuditId)).data.warungName == resource.data.name
        && getAfter(auditPath(data.verificationAuditId)).data.actorUid == request.auth.uid
        && getAfter(auditPath(data.verificationAuditId)).data.createdAt == request.time;
    }


    function reportModerationPath(reportId) {
      return /databases/$(database)/documents/postReportModeration/$(reportId);
    }

    function reportAuditPath(auditId) {
      return /databases/$(database)/documents/postReportAudit/$(auditId);
    }

    function validReportModeration(reportId, data, previousStatus) {
      return isModerator()
        && exists(/databases/$(database)/documents/postReports/$(reportId))
        && data.keys().hasAll(['reportId', 'status', 'updatedBy', 'updatedAt', 'latestAuditId'])
        && data.keys().hasOnly(['reportId', 'status', 'updatedBy', 'updatedAt', 'latestAuditId'])
        && data.reportId == reportId
        && data.status in ['Ditinjau', 'Selesai']
        && data.status != previousStatus
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.latestAuditId is string
        && getAfter(reportAuditPath(data.latestAuditId)).data.reportId == reportId
        && getAfter(reportAuditPath(data.latestAuditId)).data.previousStatus == previousStatus
        && getAfter(reportAuditPath(data.latestAuditId)).data.newStatus == data.status
        && getAfter(reportAuditPath(data.latestAuditId)).data.actorUid == request.auth.uid
        && getAfter(reportAuditPath(data.latestAuditId)).data.createdAt == request.time;
    }

    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoURL', 'bio', 'location', 'username', 'interests', 'socialLinks', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.email is string
        && (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 160))
        && (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 80))
        && (!data.keys().hasAny(['username']) || (data.username is string && data.username.matches('^[a-z0-9_]{3,20}$')))
        && (!data.keys().hasAny(['interests']) || (data.interests is list && data.interests.size() <= 8 && data.interests.hasOnly(['Ngopi', 'Kuliner', 'Nobar', 'Gim', 'Musik', 'Komunitas', 'Kerja laptop', 'Acara lokal'])))
        && (!data.keys().hasAny(['socialLinks']) || (data.socialLinks is map && data.socialLinks.keys().hasOnly(['instagram', 'tiktok', 'facebook', 'website'])));
    }

    // Six stable aggregate buckets; exact emoji stays in each user's likes document.
    // A direct lookup avoids repeatedly evaluating a 36-item allowlist in update rules.
    function reactionField(emoji) {
      return emoji in ['👍', '👏', '🙌', '💪', '🤝', '💯'] ? 'like'
        : emoji in ['❤️', '🥰', '😍', '😘', '💖', '💕'] ? 'love'
        : emoji in ['😂', '🤣', '😆', '😹', '😅', '🤪'] ? 'haha'
        : emoji in ['😮', '😲', '🤯', '🤩', '🥳', '✨'] ? 'wow'
        : emoji in ['😢', '😭', '🥺', '😔', '💔', '🫂'] ? 'sad'
        : emoji in ['😡', '🤬', '😤', '🙄', '😠', '👎'] ? 'angry'
        : '';
    }

    function validReactionEmoji(emoji) {
      return reactionField(emoji) != '';
    }

    function expectedReactionCount(oldReactions, newReactions, oldField, newField, field) {
      return newReactions.get(field, -1) == oldReactions.get(field, 0)
        + (newField == field ? 1 : 0)
        - (oldField == field ? 1 : 0);
    }

    function validReactionAggregateUpdate(postId) {
      // Gate the helper before it declares reaction-path lookups: legacy posts have no aggregate fields.
      return signedIn()
        && resource.data.keys().hasAll(['reactions', 'totalReactions'])
        && validReactionAggregateUpdateWithFields(postId);
    }

    function validReactionAggregateUpdateWithFields(postId) {
      let reactionPath = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      let beforeExists = exists(reactionPath);
      let afterExists = existsAfter(reactionPath);
      // Legacy likes without emoji are counted as 👍 in the aggregate.
      let beforeEmoji = beforeExists ? get(reactionPath).data.get('emoji', '👍') : '';
      let afterEmoji = afterExists ? getAfter(reactionPath).data.get('emoji', '') : '';
      let beforeField = reactionField(beforeEmoji);
      let afterField = reactionField(afterEmoji);
      let oldReactions = resource.data.get('reactions', {});
      let newReactions = request.resource.data.get('reactions', {});
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'totalReactions'])
        && oldReactions is map && newReactions is map
        && oldReactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && oldReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && newReactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && newReactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && newReactions.get('like', -1) is number && newReactions.get('like', -1) >= 0
        && newReactions.get('love', -1) is number && newReactions.get('love', -1) >= 0
        && newReactions.get('haha', -1) is number && newReactions.get('haha', -1) >= 0
        && newReactions.get('wow', -1) is number && newReactions.get('wow', -1) >= 0
        && newReactions.get('sad', -1) is number && newReactions.get('sad', -1) >= 0
        && newReactions.get('angry', -1) is number && newReactions.get('angry', -1) >= 0
        && resource.data.get('totalReactions', -1) is number && request.resource.data.get('totalReactions', -1) is number
        && request.resource.data.get('totalReactions', -1) >= 0
        && request.resource.data.get('totalReactions', -1) == newReactions.get('like', -1) + newReactions.get('love', -1) + newReactions.get('haha', -1) + newReactions.get('wow', -1) + newReactions.get('sad', -1) + newReactions.get('angry', -1)
        && (
          (beforeExists && !afterExists && beforeField != '')
          || (!beforeExists && afterExists && afterField != '')
          || (beforeExists && afterExists && beforeEmoji != afterEmoji
            && afterField != ''
            && (beforeEmoji == '' || beforeField != ''))
        )
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'like')
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'love')
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'haha')
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'wow')
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'sad')
        && expectedReactionCount(oldReactions, newReactions, beforeField, afterField, 'angry')
        && request.resource.data.get('totalReactions', -1) == resource.data.get('totalReactions', -1)
          + (beforeExists ? (afterExists ? 0 : -1) : 1);
    }

    function isOfficialCommunityId(communityId) {
      return communityId is string && communityId in [
        'ngopi-bareng', 'tanya-warkop', 'info-acara', 'loker',
        'jual-beli', 'jasa-lokal', 'komunitas-aktivitas'
      ];
    }

    function isOfficialThematicGroupId(groupId) {
      return groupId is string && groupId in [
        'pemilik-warkop', 'pelaku-umkm', 'info-pekerjaan', 'event-nobar',
        'komunitas-olahraga', 'kreator-lokal', 'jaringan-warga'
      ];
    }

    function thematicGroupMemberPath(groupId, memberUid) {
      return /databases/$(database)/documents/thematicGroups/$(groupId)/members/$(memberUid);
    }

    function isThematicGroupMember(groupId) {
      return signedIn()
        && isOfficialThematicGroupId(groupId)
        && exists(thematicGroupMemberPath(groupId, request.auth.uid));
    }

    function validThematicGroupReply(groupId, data) {
      return !data.keys().hasAny(['replyToMessageId'])
        || (data.replyToMessageId is string
          && exists(/databases/$(database)/documents/thematicGroups/$(groupId)/messages/$(data.replyToMessageId)));
    }

    function validThematicGroupMentions(data) {
      return !data.keys().hasAny(['mentionedUsernames'])
        || (data.mentionedUsernames is list && data.mentionedUsernames.size() <= 10);
    }

    function validCommunityTopic(communityId, topic) {
      return (communityId == 'ngopi-bareng' && topic == 'Ngopi Bareng')
        || (communityId == 'tanya-warkop' && topic == 'Tanya Warkop')
        || (communityId == 'info-acara' && topic == 'Info & Acara')
        || (communityId == 'loker' && topic == 'Loker')
        || (communityId == 'jual-beli' && topic == 'Jual Beli')
        || (communityId == 'jasa-lokal' && topic == 'Jasa Lokal')
        || (communityId == 'komunitas-aktivitas' && topic == 'Komunitas & Aktivitas');
    }

    function validPostType(topic, postType) {
      return (topic == 'Ngopi Bareng' && postType in ['Cari teman ngopi', 'Ajakan ngopi', 'Cerita suasana warkop'])
        || (topic == 'Tanya Warkop' && postType in ['Tanya menu', 'Tanya fasilitas', 'Rekomendasi warkop'])
        || (topic == 'Info & Acara' && postType in ['Info lokal', 'Acara komunitas', 'Promo warkop', 'Acara Warkop'])
        || (topic == 'Loker' && postType in ['Lowongan kerja', 'Cari pekerja', 'Paruh waktu / shift'])
        || (topic == 'Jual Beli' && postType in ['Jual barang', 'Cari barang', 'Barter'])
        || (topic == 'Jasa Lokal' && postType in ['Tawarkan jasa', 'Cari jasa', 'Promosi usaha lokal', 'Promosi usaha'])
        || (topic == 'Komunitas & Aktivitas' && postType in ['Cari komunitas', 'Ajakan olahraga / hobi', 'Kegiatan warga']);
    }

    function validPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'body', 'topic', 'createdAt', 'reactions', 'totalReactions'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'body', 'topic', 'postType', 'warungId', 'location', 'eventDate', 'eventStartAt', 'eventEndAt', 'eventKind', 'eventCapacity', 'eventStatus', 'price', 'workType', 'contact', 'communityId', 'videoThumbnailURL', 'createdAt', 'reactions', 'totalReactions'])
        && data.reactions is map
        && data.reactions.keys().hasAll(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && data.reactions.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'angry'])
        && data.reactions.like is number && data.reactions.like >= 0
        && data.reactions.love is number && data.reactions.love >= 0
        && data.reactions.haha is number && data.reactions.haha >= 0
        && data.reactions.wow is number && data.reactions.wow >= 0
        && data.reactions.sad is number && data.reactions.sad >= 0
        && data.reactions.angry is number && data.reactions.angry >= 0
        && data.totalReactions is number && data.totalReactions >= 0
        && data.totalReactions == data.reactions.like + data.reactions.love + data.reactions.haha + data.reactions.wow + data.reactions.sad + data.reactions.angry
        && (!data.keys().hasAny(['videoThumbnailURL']) || (data.videoThumbnailURL is string && data.videoThumbnailURL.size() <= 150000 && data.videoThumbnailURL.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && data.authorId is string
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && (!data.keys().hasAny(['authorPhotoURL']) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048))
        && (!data.keys().hasAny(['warungId']) || (data.warungId is string && exists(/databases/$(database)/documents/warungs/$(data.warungId)) && get(/databases/$(database)/documents/warungs/$(data.warungId)).data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/warungs/$(data.warungId)).data.verificationStatus == 'verified'))
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 2000
        && data.topic in ['Ngopi Bareng', 'Tanya Warkop', 'Info & Acara', 'Loker', 'Jual Beli', 'Jasa Lokal', 'Komunitas & Aktivitas']
        && (!data.keys().hasAny(['postType']) || (data.postType is string && data.postType.size() <= 80 && validPostType(data.topic, data.postType)))
        && (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 160))
        && (!data.keys().hasAny(['eventDate']) || (data.eventDate is string && data.eventDate.size() <= 40))
        && (!data.keys().hasAny(['eventStartAt']) || (data.eventStartAt is string && data.eventStartAt.size() <= 40))
        && (!data.keys().hasAny(['eventEndAt']) || (data.eventEndAt is string && data.eventEndAt.size() <= 40))
        && (!data.keys().hasAny(['eventKind']) || (data.eventKind is string && data.eventKind.size() <= 40))
        && (!data.keys().hasAny(['eventCapacity']) || (data.eventCapacity is number && data.eventCapacity >= 1 && data.eventCapacity <= 10000))
        && (!data.keys().hasAny(['price']) || (data.price is string && data.price.size() <= 60))
        && (!data.keys().hasAny(['workType']) || (data.workType is string && data.workType.size() <= 60))
        && (!data.keys().hasAny(['contact']) || (data.contact is string && data.contact.size() <= 240
          && (data.contact.matches('https://.*') || data.contact.matches('@[A-Za-z0-9_.]{2,40}'))))
        && (!data.keys().hasAny(['communityId']) || (
          isOfficialCommunityId(data.communityId)
          && validCommunityTopic(data.communityId, data.topic)
        ))
        && data.createdAt == request.time;
    }

    function validOfficialWarungRegion(data) {
      return data.keys().hasAll([
          'regionCode', 'provinceCode', 'provinceName', 'regencyCode', 'regencyName',
          'districtCode', 'districtName', 'villageCode', 'villageName'
        ])
        && data.regionCode == data.villageCode
        && data.provinceCode is string && data.provinceCode.matches('^[0-9]{2}$')
        && data.regencyCode is string && data.regencyCode.matches('^[0-9]{2}[.][0-9]{2}$')
        && data.regencyCode.matches('^' + data.provinceCode + '[.][0-9]{2}$')
        && data.districtCode is string && data.districtCode.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{2}$')
        && data.districtCode.matches('^' + data.regencyCode + '[.][0-9]{2}$')
        && data.villageCode is string && data.villageCode.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{2}[.][0-9]{4}$')
        && data.villageCode.matches('^' + data.districtCode + '[.][0-9]{4}$')
        && data.provinceName is string && data.provinceName.size() >= 2 && data.provinceName.size() <= 100
        && data.regencyName is string && data.regencyName.size() >= 2 && data.regencyName.size() <= 100
        && data.districtName is string && data.districtName.size() >= 2 && data.districtName.size() <= 100
        && data.villageName is string && data.villageName.size() >= 2 && data.villageName.size() <= 100;
    }

    // Format lama tetap dapat diedit pemilik, tetapi tidak diterima untuk pendaftaran baru.
    function validWarungRegion(data) {
      return validOfficialWarungRegion(data)
        || (data.regionCode == 'lamongan-kab' && !data.keys().hasAny([
          'provinceCode', 'provinceName', 'regencyCode', 'regencyName',
          'districtCode', 'districtName', 'villageCode', 'villageName'
        ]))
        || (
          data.regionCode is string && data.regionCode.matches('^id-[a-z0-9-]{3,90}$')
          && data.keys().hasAll(['provinceName', 'regencyName'])
          && data.provinceName is string && data.provinceName.size() >= 2 && data.provinceName.size() <= 80
          && data.regencyName is string && data.regencyName.size() >= 2 && data.regencyName.size() <= 80
          && !data.keys().hasAny(['provinceCode', 'regencyCode', 'districtCode', 'districtName', 'villageCode', 'villageName'])
        );
    }
    function validWarung(data) {
      return data.keys().hasAll([
          'name', 'nameNormalized', 'ownerUid', 'coordinates', 'address',
          'regionCode', 'facilities', 'priceRange', 'openingHours', 'photos',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'nameNormalized', 'ownerUid', 'coordinates', 'address',
          'regionCode', 'provinceCode', 'provinceName', 'regencyCode', 'regencyName', 'districtCode', 'districtName', 'villageCode', 'villageName', 'facilities', 'activities', 'menuItems', 'specialties', 'ambience', 'priceRange', 'openingHours', 'photos',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.nameNormalized is string && data.nameNormalized.size() >= 2 && data.nameNormalized.size() <= 120
        && data.ownerUid is string
        && data.coordinates is map
        && data.coordinates.keys().hasAll(['lat', 'lng'])
        && data.coordinates.keys().hasOnly(['lat', 'lng'])
        && data.coordinates.lat is number && data.coordinates.lat >= -90 && data.coordinates.lat <= 90
        && data.coordinates.lng is number && data.coordinates.lng >= -180 && data.coordinates.lng <= 180
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && validOfficialWarungRegion(data)
        && data.facilities is list && data.facilities.size() <= 20
        && (!data.keys().hasAny(['menuItems']) || (data.menuItems is list && data.menuItems.size() <= 30))
        && (!data.keys().hasAny(['specialties']) || (data.specialties is list && data.specialties.size() <= 15))
        && (!data.keys().hasAny(['ambience']) || (data.ambience is string && data.ambience.size() <= 240))
        && (!data.keys().hasAny(['activities']) || (data.activities is list && data.activities.size() <= 9 && data.activities.hasOnly(['nobar', 'komunitas', 'gim', 'kerja-laptop', 'acara', 'olahraga', 'hobi', 'musik', 'ngopi-bareng'])))
        && data.priceRange in ['hemat', 'sedang', 'premium', 'belum-diisi']
        && data.openingHours is map
        && data.photos is list && data.photos.size() == 0
        && data.verificationStatus == 'pending'
        && !data.keys().hasAny(['verificationAuditId'])
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validNewWarungPhotoUrl(photo, warungId) {
      return photo is string
        && photo.size() <= 2048
        && photo.matches('https://klikvxuronunonymmiqv[.]supabase[.]co/storage/v1/object/public/warkoplink-media/warungs/' + warungId + '/[0-4]/[0-9a-f-]{36}[.]webp');
    }

    function validWarungPhotoList(photos, warungId, oldPhotos) {
      return photos is list
        && photos.size() <= 5
        && (photos.size() == 0 || photos[0] in oldPhotos || validNewWarungPhotoUrl(photos[0], warungId))
        && (photos.size() < 2 || photos[1] in oldPhotos || validNewWarungPhotoUrl(photos[1], warungId))
        && (photos.size() < 3 || photos[2] in oldPhotos || validNewWarungPhotoUrl(photos[2], warungId))
        && (photos.size() < 4 || photos[3] in oldPhotos || validNewWarungPhotoUrl(photos[3], warungId))
        && (photos.size() < 5 || photos[4] in oldPhotos || validNewWarungPhotoUrl(photos[4], warungId));
    }

    function validWarungEdit(data, warungId, oldPhotos) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.nameNormalized is string && data.nameNormalized.size() >= 2 && data.nameNormalized.size() <= 120
        && data.coordinates is map
        && data.coordinates.keys().hasAll(['lat', 'lng'])
        && data.coordinates.keys().hasOnly(['lat', 'lng'])
        && data.coordinates.lat is number && data.coordinates.lat >= -90 && data.coordinates.lat <= 90
        && data.coordinates.lng is number && data.coordinates.lng >= -180 && data.coordinates.lng <= 180
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && validWarungRegion(data)
        && data.facilities is list && data.facilities.size() <= 20
        && (!data.keys().hasAny(['menuItems']) || (data.menuItems is list && data.menuItems.size() <= 30))
        && (!data.keys().hasAny(['specialties']) || (data.specialties is list && data.specialties.size() <= 15))
        && (!data.keys().hasAny(['ambience']) || (data.ambience is string && data.ambience.size() <= 240))
        && (!data.keys().hasAny(['activities']) || (data.activities is list && data.activities.size() <= 9 && data.activities.hasOnly(['nobar', 'komunitas', 'gim', 'kerja-laptop', 'acara', 'olahraga', 'hobi', 'musik', 'ngopi-bareng'])))
        && data.priceRange in ['hemat', 'sedang', 'premium', 'belum-diisi']
        && data.openingHours is map
        && validWarungPhotoList(data.photos, warungId, oldPhotos);
    }

    // Profil publik tidak pernah memuat email atau data autentikasi privat.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bio', 'location', 'username', 'interests', 'socialLinks', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['username']) || request.resource.data.username.matches('^[a-z0-9_]{3,20}$'))
        && (!request.resource.data.keys().hasAny(['bio']) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!request.resource.data.keys().hasAny(['location']) || (request.resource.data.location is string && request.resource.data.location.size() <= 80))
        && (!request.resource.data.keys().hasAny(['interests']) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 8 && request.resource.data.interests.hasOnly(['Ngopi', 'Kuliner', 'Nobar', 'Gim', 'Musik', 'Komunitas', 'Kerja laptop', 'Acara lokal'])))
        && (!request.resource.data.keys().hasAny(['socialLinks']) || (request.resource.data.socialLinks is map && request.resource.data.socialLinks.keys().hasOnly(['instagram', 'tiktok', 'facebook', 'website'])));
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'location', 'username', 'interests', 'socialLinks', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['username']) || request.resource.data.username.matches('^[a-z0-9_]{3,20}$'))
        && (!request.resource.data.keys().hasAny(['bio']) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!request.resource.data.keys().hasAny(['location']) || (request.resource.data.location is string && request.resource.data.location.size() <= 80))
        && (!request.resource.data.keys().hasAny(['interests']) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 8 && request.resource.data.interests.hasOnly(['Ngopi', 'Kuliner', 'Nobar', 'Gim', 'Musik', 'Komunitas', 'Kerja laptop', 'Acara lokal'])))
        && (!request.resource.data.keys().hasAny(['socialLinks']) || (request.resource.data.socialLinks is map && request.resource.data.socialLinks.keys().hasOnly(['instagram', 'tiktok', 'facebook', 'website'])));
      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfile(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'bio', 'location', 'username', 'interests', 'socialLinks'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && (!request.resource.data.keys().hasAny(['photoURL']) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && (!request.resource.data.keys().hasAny(['bio']) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!request.resource.data.keys().hasAny(['location']) || (request.resource.data.location is string && request.resource.data.location.size() <= 80))
        && (!request.resource.data.keys().hasAny(['username']) || (request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9_]{3,20}$') && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)) && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId))
        && (!request.resource.data.keys().hasAny(['interests']) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 8 && request.resource.data.interests.hasOnly(['Ngopi', 'Kuliner', 'Nobar', 'Gim', 'Musik', 'Komunitas', 'Kerja laptop', 'Acara lokal'])))
        && (!request.resource.data.keys().hasAny(['socialLinks']) || (request.resource.data.socialLinks is map && request.resource.data.socialLinks.keys().hasOnly(['instagram', 'tiktok', 'facebook', 'website'])));
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Legacy membership records are retained for compatibility only.
    // Seven conversation categories no longer use join/leave membership.
    match /communities/{communityId}/members/{memberUid} {
      allow read: if signedIn() && request.auth.uid == memberUid;
      allow create, update: if false;
      allow delete: if signedIn()
        && isOfficialCommunityId(communityId)
        && request.auth.uid == memberUid;
    }

    // Grup Tematik: keanggotaan mandiri, tanpa peran admin/moderator khusus.
    // Riwayat pesan tetap tersimpan; akses pesan hanya aktif selama pengguna menjadi anggota.
    match /thematicGroups/{groupId}/members/{memberUid} {
      allow read: if signedIn()
        && isOfficialThematicGroupId(groupId)
        && request.auth.uid == memberUid;
      allow create: if signedIn()
        && isOfficialThematicGroupId(groupId)
        && request.auth.uid == memberUid
        && request.resource.data.keys().hasAll(['uid', 'joinedAt', 'lastReadAt'])
        && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'lastReadAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastReadAt == request.time;
      allow update: if signedIn()
        && isOfficialThematicGroupId(groupId)
        && request.auth.uid == memberUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.lastReadAt == request.time;
      allow delete: if signedIn()
        && isOfficialThematicGroupId(groupId)
        && request.auth.uid == memberUid;
    }

    match /thematicGroups/{groupId}/messages/{messageId} {
      allow read: if isThematicGroupMember(groupId);
      allow create: if isThematicGroupMember(groupId)
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt', 'replyToMessageId', 'mentionedUsernames'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && validThematicGroupReply(groupId, request.resource.data)
        && validThematicGroupMentions(request.resource.data);
      allow update, delete: if false;
    }

    match /thematicGroups/{groupId}/reactions/{reactionId} {
      allow read: if isThematicGroupMember(groupId);
      allow create: if isThematicGroupMember(groupId)
        && request.resource.data.keys().hasAll(['messageId', 'uid', 'emoji', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['messageId', 'uid', 'emoji', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && reactionId == request.resource.data.messageId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/thematicGroups/$(groupId)/messages/$(request.resource.data.messageId))
        && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🔥']
        && request.resource.data.updatedAt == request.time;
      allow update: if isThematicGroupMember(groupId)
        && request.auth.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.messageId == resource.data.messageId
        && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🔥']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isThematicGroupMember(groupId) && request.auth.uid == resource.data.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && validPost(request.resource.data);
      allow update: if (
        signedIn()
        && resource.data.get('authorId', '') == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'topic', 'eventDate', 'eventStartAt', 'eventEndAt', 'eventKind', 'eventCapacity', 'eventStatus', 'location', 'postType', 'eventPhotoURL', 'videoURL'])
            && request.resource.data.get('body', '') is string
            && request.resource.data.get('body', '').size() >= 1
            && request.resource.data.get('body', '').size() <= 2000
            && (!request.resource.data.keys().hasAny(['eventStartAt']) || (request.resource.data.eventStartAt is string && request.resource.data.eventStartAt.size() <= 40))
            && (!request.resource.data.keys().hasAny(['eventEndAt']) || (request.resource.data.eventEndAt is string && request.resource.data.eventEndAt.size() <= 40))
            && (!request.resource.data.keys().hasAny(['eventKind']) || (request.resource.data.eventKind is string && request.resource.data.eventKind.size() <= 40))
            && (!request.resource.data.keys().hasAny(['eventCapacity']) || (request.resource.data.eventCapacity is number && request.resource.data.eventCapacity >= 1 && request.resource.data.eventCapacity <= 10000))
            && (!request.resource.data.keys().hasAny(['eventStatus']) || request.resource.data.eventStatus in ['scheduled', 'cancelled'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventPhotoURL']) || (request.resource.data.eventPhotoURL is string && request.resource.data.eventPhotoURL.size() <= 2048 && resource.data.get('warungId', '') is string && get(/databases/$(database)/documents/warungs/$(resource.data.warungId)).data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/warungs/$(resource.data.warungId)).data.verificationStatus == 'verified' && request.resource.data.eventPhotoURL.matches('https://klikvxuronunonymmiqv[.]supabase[.]co/storage/v1/object/public/warkoplink-media/events/' + postId + '/[0-9a-f-]{36}[.]webp')))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['videoURL']) || (request.resource.data.videoURL is string && request.resource.data.videoURL.size() <= 2048 && request.resource.data.videoURL.matches('https://klikvxuronunonymmiqv[.]supabase[.]co/storage/v1/object/public/warkoplink-video/posts/' + postId + '/[0-9a-f-]{36}[.]mp4')))
            && (
              request.resource.data.get('topic', '') in ['Ngopi Bareng', 'Tanya Warkop', 'Info & Acara', 'Loker', 'Jual Beli', 'Jasa Lokal', 'Komunitas & Aktivitas']
              || (request.resource.data.get('topic', '') == resource.data.get('topic', '')
                && resource.data.get('topic', '') in ['Obrolan Umum', 'Tanya Jawab', 'Info Layanan', 'Ide & Saran', 'Jual Beli & Jasa Lokal'])
            )
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['topic', 'postType'])
              || !request.resource.data.keys().hasAny(['postType'])
              || validPostType(request.resource.data.get('topic', ''), request.resource.data.get('postType', '')))
            && (!resource.data.keys().hasAny(['communityId'])
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['topic'])
              || validCommunityTopic(resource.data.communityId, request.resource.data.get('topic', resource.data.get('topic', ''))))
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
            && request.resource.data.get('deleting', false) == true
          )
        )
      ) || validReactionAggregateUpdate(postId);
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && resource.data.get('deleting', false) == true;
    }

    // RSVP acara: satu dokumen per pengguna, realtime count, status dibatasi.
    match /posts/{postId}/eventRsvps/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.topic == 'Info & Acara'
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) != true
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('eventStatus', 'scheduled') != 'cancelled'
        && request.resource.data.keys().hasAll(['uid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['going', 'maybe']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.status in ['going', 'maybe']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /posts/{postId}/likes/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'emoji'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time
        && (!('emoji' in request.resource.data) || validReactionEmoji(request.resource.data.emoji))
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) != true;
      allow delete: if signedIn()
        && (
          request.auth.uid == userId
          || (
            exists(/databases/$(database)/documents/posts/$(postId))
            && get(/databases/$(database)/documents/posts/$(postId)).data.keys().hasAll(['authorId', 'deleting'])
            && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
            && get(/databases/$(database)/documents/posts/$(postId)).data.deleting == true
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
        && validReactionEmoji(request.resource.data.emoji);
    }

    match /posts/{postId}/replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) != true
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'body', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'body', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && (!request.resource.data.keys().hasAny(['authorPhotoURL']) || request.resource.data.authorPhotoURL == null || (request.resource.data.authorPhotoURL is string && request.resource.data.authorPhotoURL.size() <= 2048))
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(postId)).data.get('deleting', false) == true;
    }

    // Direktori publik hanya menampilkan warkop yang telah diverifikasi.
    // Pemilik tetap dapat membaca dokumen miliknya saat masih menunggu verifikasi.
    match /warungs/{warungId} {
      allow read: if isSuperAdmin()
        || resource.data.verificationStatus == 'verified'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validWarung(request.resource.data);
      // Status verifikasi, pemilik, dan waktu pembuatan tidak dapat diubah oleh pemilik.
      allow update: if validAdminDecision(warungId, request.resource.data)
        || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nameNormalized', 'coordinates', 'address', 'regionCode', 'provinceCode', 'provinceName', 'regencyCode', 'regencyName', 'districtCode', 'districtName', 'villageCode', 'villageName',
          'facilities', 'activities', 'menuItems', 'specialties', 'ambience', 'priceRange', 'openingHours', 'photos', 'updatedAt'
        ])
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos']) || request.resource.data.updatedAt == request.time)
        && validWarungEdit(request.resource.data, warungId, resource.data.get('photos', [])));
      allow delete: if false;
    }

    // Pengikut hanya dapat ditambahkan oleh akun sendiri untuk warkop terverifikasi.
    // Daftar pengikut boleh dihitung publik; dokumen identitas hanya berisi UID dan waktu.
    match /warungs/{warungId}/followers/{userId} {
      allow read: if (
        get(/databases/$(database)/documents/warungs/$(warungId)).data.verificationStatus == 'verified'
      ) || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/warungs/$(warungId)).data.verificationStatus == 'verified'
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Catatan audit hanya dapat dibuat sebagai bagian dari keputusan admin atomik.
    match /verificationAudit/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll([
          'warungId', 'warungName', 'previousStatus', 'newStatus',
          'actorUid', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'warungId', 'warungName', 'previousStatus', 'newStatus',
          'actorUid', 'reason', 'createdAt'
        ])
        && request.resource.data.warungId is string
        && request.resource.data.warungName is string
        && request.resource.data.previousStatus == 'pending'
        && request.resource.data.newStatus in ['verified', 'rejected']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && (request.resource.data.newStatus != 'rejected' || request.resource.data.reason.size() > 0)
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationStatus == 'pending'
        && getAfter(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationStatus == request.resource.data.newStatus
        && getAfter(/databases/$(database)/documents/warungs/$(request.resource.data.warungId)).data.verificationAuditId == auditId;
      allow update, delete: if false;
    }
    // Laporan bersifat privat dan hanya Moderator atau Super Admin yang boleh membacanya.
    // ID deterministik membatasi satu laporan per akun untuk setiap postingan.
    match /postReports/{reportId} {
      allow read: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['targetPostId', 'targetAuthorId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['targetPostId', 'targetAuthorId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.targetPostId is string
        && reportId == request.resource.data.targetPostId + '_' + request.auth.uid
        && request.resource.data.targetAuthorId is string
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['Spam atau promosi berulang', 'Pelecehan atau ujaran kebencian', 'Informasi berbahaya atau menyesatkan', 'Lainnya']
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId)).data.authorId == request.resource.data.targetAuthorId;
      allow update, delete: if false;
    }


    // Status moderasi terpisah dari laporan asli. Moderator dan Super Admin dapat mengelolanya.
    // Setiap perubahan wajib disertai peristiwa audit dalam batch yang sama.
    match /postReportModeration/{reportId} {
      allow read: if isModerator();
      allow create: if !exists(reportModerationPath(reportId))
        && validReportModeration(reportId, request.resource.data, 'Baru');
      allow update: if resource.data.reportId == reportId
        && validReportModeration(reportId, request.resource.data, resource.data.status);
      allow delete: if false;
    }

    // Audit moderasi bersifat append-only dan tidak dapat diperbarui/dihapus oleh klien.
    match /postReportAudit/{auditId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.keys().hasAll([
          'reportId', 'previousStatus', 'newStatus', 'actorUid', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reportId', 'previousStatus', 'newStatus', 'actorUid', 'note', 'createdAt'
        ])
        && request.resource.data.reportId is string
        && exists(/databases/$(database)/documents/postReports/$(request.resource.data.reportId))
        && request.resource.data.previousStatus in ['Baru', 'Ditinjau', 'Selesai']
        && request.resource.data.newStatus in ['Ditinjau', 'Selesai']
        && request.resource.data.newStatus != request.resource.data.previousStatus
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && ((!exists(reportModerationPath(request.resource.data.reportId))
          && request.resource.data.previousStatus == 'Baru')
          || (exists(reportModerationPath(request.resource.data.reportId))
          && get(reportModerationPath(request.resource.data.reportId)).data.status == request.resource.data.previousStatus))
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.status == request.resource.data.newStatus
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.reportId == request.resource.data.reportId
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.updatedBy == request.auth.uid
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.updatedAt == request.time
        && getAfter(reportModerationPath(request.resource.data.reportId)).data.latestAuditId == auditId;
      allow update, delete: if false;
    }

    // Notifikasi pribadi. Dokumen hanya boleh dibuat sebagai bukti aktivitas sumber
    // yang benar-benar ditulis oleh actor; penerima hanya dapat membaca/menandai miliknya.
    function validMentionText(body, username) {
      return body is string && body.matches('(?is).*@' + username + '([^a-z0-9_]|$).*');
    }

    function validNotification(data) {
      return signedIn()
        && data.keys().hasAll(['recipientUid', 'actorUid', 'type', 'createdAt', 'readAt'])
        && data.keys().hasOnly(['recipientUid', 'actorUid', 'type', 'postId', 'replyId', 'username', 'warungId', 'friendUid', 'conversationId', 'messageId', 'groupId', 'createdAt', 'readAt'])
        && data.recipientUid is string
        && data.recipientUid != request.auth.uid
        && data.actorUid == request.auth.uid
        && data.type in ['mention', 'comment', 'reaction', 'follow', 'friend', 'message']
        && data.createdAt == request.time
        && data.readAt == null
        && (
          (data.type == 'mention'
            && data.postId is string
            && exists(/databases/$(database)/documents/posts/$(data.postId))
            && data.username is string
            && exists(/databases/$(database)/documents/usernames/$(data.username))
            && get(/databases/$(database)/documents/usernames/$(data.username)).data.uid == data.recipientUid
            && (
              (!data.keys().hasAny(['replyId'])
                && get(/databases/$(database)/documents/posts/$(data.postId)).data.authorId == request.auth.uid
                && validMentionText(get(/databases/$(database)/documents/posts/$(data.postId)).data.body, data.username))
              || (data.keys().hasAny(['replyId'])
                && data.replyId is string
                && exists(/databases/$(database)/documents/posts/$(data.postId)/replies/$(data.replyId))
                && get(/databases/$(database)/documents/posts/$(data.postId)/replies/$(data.replyId)).data.authorId == request.auth.uid
                && validMentionText(get(/databases/$(database)/documents/posts/$(data.postId)/replies/$(data.replyId)).data.body, data.username))
            ))
          || (data.type == 'mention'
            && data.groupId is string
            && isOfficialThematicGroupId(data.groupId)
            && data.messageId is string
            && exists(/databases/$(database)/documents/thematicGroups/$(data.groupId)/messages/$(data.messageId))
            && get(/databases/$(database)/documents/thematicGroups/$(data.groupId)/messages/$(data.messageId)).data.senderUid == request.auth.uid
            && get(/databases/$(database)/documents/thematicGroups/$(data.groupId)/messages/$(data.messageId)).data.mentionedUsernames is list
            && data.username is string
            && data.username in get(/databases/$(database)/documents/thematicGroups/$(data.groupId)/messages/$(data.messageId)).data.mentionedUsernames
            && exists(/databases/$(database)/documents/usernames/$(data.username))
            && get(/databases/$(database)/documents/usernames/$(data.username)).data.uid == data.recipientUid
            && validMentionText(get(/databases/$(database)/documents/thematicGroups/$(data.groupId)/messages/$(data.messageId)).data.text, data.username))
          || (data.type == 'comment'
            && data.postId is string
            && exists(/databases/$(database)/documents/posts/$(data.postId))
            && data.replyId is string
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.authorId == data.recipientUid
            && exists(/databases/$(database)/documents/posts/$(data.postId)/replies/$(data.replyId))
            && get(/databases/$(database)/documents/posts/$(data.postId)/replies/$(data.replyId)).data.authorId == request.auth.uid)
          || (data.type == 'reaction'
            && data.postId is string
            && exists(/databases/$(database)/documents/posts/$(data.postId))
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.authorId == data.recipientUid
            && exists(/databases/$(database)/documents/posts/$(data.postId)/likes/$(request.auth.uid))
            && get(/databases/$(database)/documents/posts/$(data.postId)/likes/$(request.auth.uid)).data.uid == request.auth.uid)
          || (data.type == 'follow'
            && data.warungId is string
            && exists(/databases/$(database)/documents/warungs/$(data.warungId))
            && get(/databases/$(database)/documents/warungs/$(data.warungId)).data.ownerUid == data.recipientUid
            && get(/databases/$(database)/documents/warungs/$(data.warungId)).data.verificationStatus == 'verified'
            && exists(/databases/$(database)/documents/warungs/$(data.warungId)/followers/$(request.auth.uid))
            && get(/databases/$(database)/documents/warungs/$(data.warungId)/followers/$(request.auth.uid)).data.uid == request.auth.uid)
          || (data.type == 'friend'
            && data.friendUid == request.auth.uid
            && mutuallyFollows(request.auth.uid, data.recipientUid))
          || (data.type == 'message'
            && data.conversationId is string
            && data.messageId is string
            && existsAfter(conversationPath(data.conversationId))
            && request.auth.uid in getAfter(conversationPath(data.conversationId)).data.participantUids
            && data.recipientUid in getAfter(conversationPath(data.conversationId)).data.participantUids
            && existsAfter(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId))
            && getAfter(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId)).data.senderUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId)).data.recipientUid == data.recipientUid)
        );
    }

    // Klaim role hanya diterbitkan oleh Firebase Admin SDK dari lingkungan tepercaya.
    // Client tidak pernah dapat membaca/menulis dokumen role sebagai sumber otorisasi.
    match /platformRoles/{userId} {
      allow read, write: if false;
    }

    // Audit penetapan role ditulis oleh Admin SDK; hanya Super Admin dapat membacanya.
    match /platformRoleAudit/{eventId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Relasi follow antaranggota: dokumen tunggal per arah, tanpa salinan daftar teman.
    match /userFollows/{followId} {
      allow read: if signedIn()
        && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['followerUid', 'followedUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['followerUid', 'followedUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid is string
        && request.resource.data.followedUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followedUid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followedUid))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }

    // Pesan pribadi hanya untuk pasangan anggota yang saling mengikuti.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['participantUids', 'createdAt', 'updatedAt', 'lastMessagePreview', 'lastMessageAt', 'lastSenderUid', 'lastMessageId', 'unreadFor'])
        && request.resource.data.keys().hasOnly(['participantUids', 'createdAt', 'updatedAt', 'lastMessagePreview', 'lastMessageAt', 'lastSenderUid', 'lastMessageId', 'unreadFor'])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0] < request.resource.data.participantUids[1]
        && conversationId == request.resource.data.participantUids[0] + '__' + request.resource.data.participantUids[1]
        && mutuallyFollows(request.resource.data.participantUids[0], request.resource.data.participantUids[1])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.unreadFor in request.resource.data.participantUids
        && request.resource.data.unreadFor != request.auth.uid
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 96
        && validLatestConversationMessage(conversationId, request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadFor'])
            && resource.data.unreadFor == request.auth.uid
            && request.resource.data.unreadFor == '')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessagePreview', 'lastMessageAt', 'lastSenderUid', 'lastMessageId', 'unreadFor'])
            && mutuallyFollows(resource.data.participantUids[0], resource.data.participantUids[1])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.unreadFor in resource.data.participantUids
            && request.resource.data.unreadFor != request.auth.uid
            && request.resource.data.lastMessagePreview is string
            && request.resource.data.lastMessagePreview.size() <= 96
            && validLatestConversationMessage(conversationId, request.resource.data))
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(conversationPath(conversationId)).data.participantUids;
        allow create: if signedIn()
          && existsAfter(conversationPath(conversationId))
          && request.auth.uid in getAfter(conversationPath(conversationId)).data.participantUids
          && request.resource.data.keys().hasAll(['senderUid', 'recipientUid', 'body', 'createdAt', 'deliveryStatus'])
          && request.resource.data.keys().hasOnly(['senderUid', 'recipientUid', 'body', 'createdAt', 'deliveryStatus'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid in getAfter(conversationPath(conversationId)).data.participantUids
          && request.resource.data.recipientUid != request.auth.uid
          && mutuallyFollows(request.auth.uid, request.resource.data.recipientUid)
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.deliveryStatus == 'sent';
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if validNotification(request.resource.data)
        && (
          request.resource.data.type != 'friend'
          || (request.resource.data.actorUid < request.resource.data.recipientUid
            && notificationId == 'friend_' + request.resource.data.actorUid + '_' + request.resource.data.recipientUid + '_' + request.resource.data.recipientUid)
          || (request.resource.data.recipientUid < request.resource.data.actorUid
            && notificationId == 'friend_' + request.resource.data.recipientUid + '_' + request.resource.data.actorUid + '_' + request.resource.data.recipientUid)
        )
        && (
          request.resource.data.type != 'message'
          || notificationId == 'message_' + request.resource.data.messageId
        );
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
    }

  }
}
